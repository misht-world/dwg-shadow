<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AutoCAD 2021–2024 (R24.x) run on .NET Framework 4.8 -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>DwgShadow</RootNamespace>
    <AssemblyName>DwgShadow</AssemblyName>
    <!-- Single source of the version: scripts/build-bundle.ps1 stamps it into PackageContents.xml -->
    <Version>1.0.0</Version>
    <Authors>misht-world</Authors>
    <Copyright>Copyright (c) 2026 misht-world</Copyright>
    <RepositoryUrl>https://github.com/misht-world/dwg-shadow</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>DwgShadow</Product>
    <Description>Building shadows from footprint contours in AutoCAD</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoCAD 2021 (R24.0) assemblies: compile-time only, not copied to the output. -->
    <PackageReference Include="AutoCAD.NET" Version="24.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Robust polygon boolean operations -->
    <PackageReference Include="Clipper2" Version="1.5.4" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
